<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Официальный NuGet -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Фид BepInEx: BepInEx.Core (5.x), UnityEngine.Modules -->
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
    <!-- Запасной фид с UnityEngine.Modules -->
    <add key="samboy" value="https://nuget.samboy.dev/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
