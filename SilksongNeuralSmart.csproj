<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SilksongNeuralSmart</AssemblyName>
    <Description>Silksong Neural Smart: Autonomous Balanced Neural AI for Hollow Knight: Silksong (BepInEx)</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SilksongNeuralSmart</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx & Harmony Dependencies (Provided at runtime by BepInEx in Silksong/BepInEx/core) -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.724" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
    <PackageReference Include="HarmonyX" Version="2.14.0" />
  </ItemGroup>

</Project>
