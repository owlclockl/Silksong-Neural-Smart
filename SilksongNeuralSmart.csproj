<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Silksong собран на Unity Mono (BepInEx 5) -> целевой фреймворк net472.
      Для BepInEx 6 / IL2CPP соберите с параметром: -p:TargetFramework=netstandard2.1
      (или запустите build.bat с ключом il2cpp / -il2cpp)
    -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net472</TargetFramework>
    <AssemblyName>SilksongNeuralSmart</AssemblyName>
    <Product>Silksong Neural Smart</Product>
    <Description>Silksong Neural Smart: Autonomous Balanced Neural AI + Grand Arena training mode for Hollow Knight: Silksong (BepInEx)</Description>
    <Version>1.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SilksongNeuralSmart</RootNamespace>
    <AssemblyTitle>Silksong Neural Smart</AssemblyTitle>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0414;MSB3277</NoWarn>
    <RestoreAdditionalProjectSources></RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!--
    ================================================================
    1) АВТОПОИСК УСТАНОВЛЕННОЙ ИГРЫ
    Если Silksong найден, сборка идёт против реальных сборок игры и BepInEx
    (самый надёжный путь, интернет не требуется).
    Путь можно задать вручную:  -p:SilksongPath="D:\Games\Hollow Knight Silksong"
    или переменной окружения SILKSONG_PATH.
    ================================================================
  -->
  <PropertyGroup Label="SilksongDetection">
    <SilksongPath Condition="'$(SilksongPath)' == '' AND '$(SILKSONG_PATH)' != ''">$(SILKSONG_PATH)</SilksongPath>
    <SilksongPath Condition="'$(SilksongPath)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Hollow Knight Silksong')">C:\Program Files (x86)\Steam\steamapps\common\Hollow Knight Silksong</SilksongPath>
    <SilksongPath Condition="'$(SilksongPath)' == '' AND Exists('C:\Program Files\Steam\steamapps\common\Hollow Knight Silksong')">C:\Program Files\Steam\steamapps\common\Hollow Knight Silksong</SilksongPath>
    <SilksongPath Condition="'$(SilksongPath)' == '' AND Exists('D:\SteamLibrary\steamapps\common\Hollow Knight Silksong')">D:\SteamLibrary\steamapps\common\Hollow Knight Silksong</SilksongPath>
    <SilksongPath Condition="'$(SilksongPath)' == '' AND Exists('E:\SteamLibrary\steamapps\common\Hollow Knight Silksong')">E:\SteamLibrary\steamapps\common\Hollow Knight Silksong</SilksongPath>

    <SilksongManagedPath Condition="'$(SilksongManagedPath)' == '' AND '$(SilksongPath)' != ''">$(SilksongPath)\Hollow Knight Silksong_Data\Managed</SilksongManagedPath>
    <SilksongBepInExCore Condition="'$(SilksongBepInExCore)' == '' AND '$(SilksongPath)' != ''">$(SilksongPath)\BepInEx\core</SilksongBepInExCore>

    <UseGameReferences Condition="'$(SilksongManagedPath)' != '' AND Exists('$(SilksongManagedPath)\UnityEngine.CoreModule.dll') AND Exists('$(SilksongBepInExCore)\BepInEx.dll')">true</UseGameReferences>
  </PropertyGroup>

  <Target Name="ReportReferenceMode" BeforeTargets="BeforeBuild">
    <Message Importance="high" Condition="'$(UseGameReferences)' == 'true'" Text="[SilksongNeuralSmart] Сборка против локальных сборок игры: $(SilksongPath)" />
    <Message Importance="high" Condition="'$(UseGameReferences)' != 'true'" Text="[SilksongNeuralSmart] Игра не найдена — сборка против NuGet-пакетов (UnityEngine.Modules + BepInEx)." />
  </Target>

  <!-- ================= Локальные сборки игры (предпочтительно) ================= -->
  <ItemGroup Condition="'$(UseGameReferences)' == 'true'">
    <Reference Include="BepInEx">
      <HintPath>$(SilksongBepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SilksongBepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(SilksongManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SilksongManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SilksongManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SilksongManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(SilksongManagedPath)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(SilksongManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ================= Резервный путь: NuGet ================= -->
  <ItemGroup Condition="'$(UseGameReferences)' != 'true'">
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" Condition="'$(TargetFramework)' == 'net472'" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.725" Condition="'$(TargetFramework)' == 'netstandard2.1'" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.14.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Позволяет собирать net472 одним лишь .NET SDK, без Visual Studio -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- Предобученные нейросети едут вместе с модом (build.bat копирует их в dist) -->
  <ItemGroup>
    <None Include="PretrainedBrains\**\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="PretrainedBrains" />
  </ItemGroup>

</Project>
